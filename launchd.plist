<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
 "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>

    <!-- Unique identifier -->
    <key>Label</key>
    <string>com.user.dynamicwallpaper</string>

    <!-- Command to run -->
    <key>ProgramArguments</key>
    <array>
      <string>/Users/YOUR_USERNAME/Path/to/wallpaper/venv/bin/python3</string>
      <string>/Users/YOUR_USERNAME/Path/to/wallpaper/generate_and_set_wallpaper.py</string>
    </array>

    <!-- Run every 60 seconds -->
    <key>StartInterval</key>
    <integer>60</integer>

    <!-- Run once at load (optional but useful) -->
    <key>RunAtLoad</key>
    <true/>

    <!-- Needed for wallpaper / UI access -->
    <key>ProcessType</key>
    <string>Interactive</string>

    <!-- Logging -->
    <key>StandardOutPath</key>
    <string>/tmp/dynamicwallpaper.out</string>
    <key>StandardErrorPath</key>
    <string>/tmp/dynamicwallpaper.err</string>

  </dict>
</plist>
